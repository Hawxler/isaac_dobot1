#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.3.2"
    }
    defaultPrim = "magician"
    endTimeCode = 1000000
    kilogramsPerUnit = 1
    metersPerUnit = 1
    startTimeCode = 0
    subLayers = [
        @./physics.usda@
    ]
    upAxis = "Z"
)

over "magician"
{
    over "Physics"
    {
        over "magician_joint_1" (
            delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
            prepend apiSchemas = ["MjcJointAPI"]
        )
        {
        }

        over "magician_joint_2" (
            delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
            prepend apiSchemas = ["MjcJointAPI"]
        )
        {
        }

        over "magician_joint_3" (
            delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
            prepend apiSchemas = ["MjcJointAPI"]
        )
        {
        }

        over "magician_joint_mimic_1" (
            delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
            prepend apiSchemas = ["MjcJointAPI"]
        )
        {
        }

        over "magician_joint_mimic_2" (
            delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
            prepend apiSchemas = ["MjcJointAPI"]
        )
        {
        }

        over "magician_joint_4" (
            delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
            prepend apiSchemas = ["MjcJointAPI"]
        )
        {
        }

        def MjcActuator "magician_joint_1_actuator"
        {
            uniform double mjc:forceRange:max = 2000
            uniform double mjc:forceRange:min = -2000
            custom rel mjc:target
            append rel mjc:target = </magician/Physics/magician_joint_1>
        }

        def MjcActuator "magician_joint_2_actuator"
        {
            uniform double mjc:forceRange:max = 2000
            uniform double mjc:forceRange:min = -2000
            custom rel mjc:target
            append rel mjc:target = </magician/Physics/magician_joint_2>
        }

        def MjcActuator "magician_joint_3_actuator"
        {
            uniform double mjc:forceRange:max = 2000
            uniform double mjc:forceRange:min = -2000
            custom rel mjc:target
            append rel mjc:target = </magician/Physics/magician_joint_3>
        }

        def MjcActuator "magician_joint_mimic_1_actuator"
        {
            uniform double mjc:forceRange:max = 2000
            uniform double mjc:forceRange:min = -2000
            custom rel mjc:target
            append rel mjc:target = </magician/Physics/magician_joint_mimic_1>
        }

        def MjcActuator "magician_joint_mimic_2_actuator"
        {
            uniform double mjc:forceRange:max = 2000
            uniform double mjc:forceRange:min = -2000
            custom rel mjc:target
            append rel mjc:target = </magician/Physics/magician_joint_mimic_2>
        }

        def MjcActuator "magician_joint_4_actuator"
        {
            uniform double mjc:forceRange:max = 2000
            uniform double mjc:forceRange:min = -2000
            custom rel mjc:target
            append rel mjc:target = </magician/Physics/magician_joint_4>
        }
    }
}

